{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "extension",
    "declaration": true,
    "declarationMap": true,
    "types": ["node"]
  },
  "include": ["extension/index.ts", "extension/tools/index.ts"]
}
